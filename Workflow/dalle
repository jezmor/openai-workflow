#!/usr/bin/osascript -l JavaScript

// Helpers
function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

function isDir(path) {
  return $.NSFileManager.defaultManager.attributesOfItemAtPathError(path, undefined).js["NSFileType"].js === "NSFileTypeDirectory"
}

function makeDir(path) {
  return $.NSFileManager.defaultManager.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(
    path, true, undefined, undefined)
}

function dirContents(path) {
  return $.NSFileManager.defaultManager.contentsOfDirectoryAtURLIncludingPropertiesForKeysOptionsError(
    $.NSURL.fileURLWithPath(path), undefined, $.NSDirectoryEnumerationSkipsHiddenFiles, undefined)
    .js.map(p => p.path.js).sort()
}

function extractPrompt(path) {
  // Extract description from metadata
  const task = $.NSTask.alloc.init
  const stdout = $.NSPipe.pipe

  task.executableURL = $.NSURL.fileURLWithPath("/usr/bin/xattr")
  task.arguments = ["-p", "com.apple.metadata:kMDItemDescription", path]
  task.standardOutput = stdout
  task.launchAndReturnError(false)

  const dataOut = stdout.fileHandleForReading.readDataToEndOfFileAndReturnError(false)
  const stringOut = $.NSPropertyListSerialization.propertyListWithDataOptionsFormatError(dataOut, [], undefined, undefined).js

  // Extract prompt from description
  if (stringOut === undefined) return "**No prompt found**"

  const promptRegex = /^(\w+ Prompt:)/
  return stringOut
    .split("\n")
    .filter(line => line.match(promptRegex))
    .map(line => line.replace(promptRegex, "**$1**"))
    .join("\n\n")
}

function writeMetadata(field, text, path) {
  // Convert to plist
  const plistData = $.NSPropertyListSerialization.dataWithPropertyListFormatOptionsError(text, $.NSPropertyListXMLFormat_v1_0, 0, undefined)
  const plistString = $.NSString.alloc.initWithDataEncoding(plistData, $.NSUTF8StringEncoding).js

  // Write plist
  const task = $.NSTask.alloc.init

  task.executableURL = $.NSURL.fileURLWithPath("/usr/bin/xattr")
  task.arguments = ["-w", `com.apple.metadata:${field}`, plistString, path]
  task.launchAndReturnError(false)
}

function padDate(number) {
  return number.toString().padStart(2, "0")
}

function markdownImage(path) {
  const imageMarkdown = `![](${path})`
  const promptMarkdown = extractPrompt(path)
  return `${promptMarkdown}\n${imageMarkdown}`
}

function writeFile(path, text) {
  $(text).writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, undefined)
}

// Main
function run(argv) {
  const typedQuery = argv[0]
  const maxEntries = 10
  const region = envVar("aws_region") || "us-east-1"
  const profile = envVar("aws_profile") || ""
  const model = envVar("image_model") || "amazon.nova-canvas-v1:0"
  const imageQuality = envVar("image_quality") || "standard"
  const parentFolder = envVar("dalle_images_folder")
  const includeMetadata = envVar("dalle_write_metadata")

  // Load previous images and prompts
  makeDir(parentFolder)

  const previousEntries = dirContents(parentFolder)
    .filter(entry => !isDir(entry))
    .filter(file => file.endsWith(".png"))
    .slice(-maxEntries)
    .map(image => markdownImage(image))
    .join("\n\n")

  // If given an argument, load previous entries early and rerun to start the process
  if (!envVar("loaded_previous")) return JSON.stringify({
    rerun: 0.1,
    variables: { loaded_previous: true },
    response: previousEntries,
    behaviour: { scroll: "end" }
  })

  // If argument is empty, return previous entries
  if (typedQuery.length === 0) return JSON.stringify({
    variables: { loaded_previous: true },
    response: previousEntries,
    behaviour: { scroll: "end" }
  })

  // Build request body based on model
  let requestBody
  if (model.startsWith("stability.")) {
    // Stability AI models on Bedrock
    requestBody = JSON.stringify({
      text_prompts: [{ text: typedQuery, weight: 1.0 }],
      cfg_scale: 8,
      steps: 50,
      width: 1024,
      height: 1024
    })
  } else {
    // Amazon Nova Canvas (default)
    const dimensions = imageQuality === "hd" ?
      { width: 2048, height: 2048 } :
      { width: 1024, height: 1024 }

    requestBody = JSON.stringify({
      taskType: "TEXT_IMAGE",
      textToImageParams: {
        text: typedQuery
      },
      imageGenerationConfig: {
        numberOfImages: 1,
        quality: imageQuality,
        width: dimensions.width,
        height: dimensions.height,
        cfgScale: 8.0
      }
    })
  }

  // Write body to temp file
  const cacheDir = envVar("alfred_workflow_cache")
  makeDir(cacheDir)
  const bodyFile = `${cacheDir}/image_body.json`
  const outputFile = `${cacheDir}/image_response.json`
  writeFile(bodyFile, requestBody)

  // Call Bedrock invoke-model via AWS CLI
  const profileArg = profile ? `--profile ${profile}` : ""
  const task = $.NSTask.alloc.init
  const stdout = $.NSPipe.pipe
  const stderr = $.NSPipe.pipe

  task.executableURL = $.NSURL.fileURLWithPath("/bin/zsh")
  task.arguments = ["-c", `export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:$PATH" && aws bedrock-runtime invoke-model ${profileArg} --region ${region} --model-id "${model}" --content-type "application/json" --accept "application/json" --body file://${bodyFile} ${outputFile} 2>&1`]
  task.standardOutput = stdout
  task.standardError = stderr
  task.launchAndReturnError(false)
  task.waitUntilExit

  const stderrData = stdout.fileHandleForReading.readDataToEndOfFileAndReturnError(false)
  const stderrStr = $.NSString.alloc.initWithDataEncoding(stderrData, $.NSUTF8StringEncoding).js

  // Check for CLI errors
  if (task.terminationStatus !== 0) {
    const errorMsg = stderrStr || "Unknown error calling AWS Bedrock"
    // Clean up
    $.NSFileManager.defaultManager.removeItemAtPathError(bodyFile, undefined)
    $.NSFileManager.defaultManager.removeItemAtPathError(outputFile, undefined)

    return JSON.stringify({
      variables: { loaded_previous: true },
      response: `${previousEntries}\n\n**Prompt:** ${typedQuery}\n\n⚠️ ${errorMsg}`,
      behaviour: { response: "append", scroll: "end" }
    })
  }

  // Read response
  const responseData = $.NSString.stringWithContentsOfFileEncodingError(outputFile, $.NSUTF8StringEncoding, undefined).js
  // Clean up temp files
  $.NSFileManager.defaultManager.removeItemAtPathError(bodyFile, undefined)
  $.NSFileManager.defaultManager.removeItemAtPathError(outputFile, undefined)

  let response
  try {
    response = JSON.parse(responseData)
  } catch(e) {
    return JSON.stringify({
      variables: { loaded_previous: true },
      response: `${previousEntries}\n\n**Prompt:** ${typedQuery}\n\n⚠️ Failed to parse response: ${responseData}`,
      behaviour: { response: "append", scroll: "end" }
    })
  }

  // Check for error in response
  if (response["error"] || response["message"]) {
    const errorMsg = response["error"] || response["message"]
    return JSON.stringify({
      variables: { loaded_previous: true },
      response: `${previousEntries}\n\n**Prompt:** ${typedQuery}\n\n⚠️ ${errorMsg}`,
      behaviour: { response: "append", scroll: "end" }
    })
  }

  // Extract base64 images from response
  let base64Images = []

  if (model.startsWith("stability.")) {
    // Stability AI response format
    base64Images = (response["artifacts"] || []).map(a => a["base64"])
  } else {
    // Amazon Nova Canvas response format
    base64Images = response["images"] || []
  }

  if (base64Images.length === 0) {
    return JSON.stringify({
      variables: { loaded_previous: true },
      response: `${previousEntries}\n\n**Prompt:** ${typedQuery}\n\n⚠️ No images returned in response`,
      behaviour: { response: "append", scroll: "end" }
    })
  }

  // Save images
  const creationDate = new Date()
  const creationYear = creationDate.getFullYear()
  const creationMonth = padDate(creationDate.getMonth() + 1)
  const creationDay = padDate(creationDate.getDate())
  const creationHour = padDate(creationDate.getHours())
  const creationMinute = padDate(creationDate.getMinutes())
  const creationSecond = padDate(creationDate.getSeconds())

  const promptText = `Original Prompt: ${typedQuery}`

  const downloadedImages = base64Images.map(b64 => {
    const uid = $.NSProcessInfo.processInfo.globallyUniqueString.js.split("-")[0]
    const imagePath = `${parentFolder}/${creationYear}.${creationMonth}.${creationDay}.${creationHour}.${creationMinute}.${creationSecond}-${uid}.png`

    // Decode base64 and write to file
    const nsData = $.NSData.alloc.initWithBase64EncodedStringOptions(b64, 0)
    nsData.writeToFileAtomically(imagePath, true)

    if (includeMetadata) {
      const modelName = model.startsWith("stability.") ? "Stability AI" : "Amazon Nova Canvas"
      writeMetadata("kMDItemCreator", modelName, imagePath)
      writeMetadata("kMDItemDescription", `Generated with ${modelName} via Alfred workflow.\n\n${promptText}`, imagePath)
    }

    return imagePath
  })

  // Append results
  return JSON.stringify({
    variables: { loaded_previous: true },
    response: downloadedImages.map(image => markdownImage(image)).join("\n\n"),
    behaviour: { response: "append" }
  })
}
