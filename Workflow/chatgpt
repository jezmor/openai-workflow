#!/usr/bin/osascript -l JavaScript

// Helpers
function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

function fileExists(path) {
  return $.NSFileManager.defaultManager.fileExistsAtPath(path)
}

function fileModified(path) {
  return $.NSFileManager.defaultManager
    .attributesOfItemAtPathError(path, undefined)
    .js["NSFileModificationDate"].js
    .getTime()
}

function deleteFile(path) {
  return $.NSFileManager.defaultManager.removeItemAtPathError(path, undefined)
}

function writeFile(path, text) {
  $(text).writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, undefined)
}

function readChat(path) {
  const chatString = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, undefined).js
  return JSON.parse(chatString)
}

function appendChat(path, message) {
  const ongoingChat = readChat(path).concat(message)
  const chatString = JSON.stringify(ongoingChat)
  writeFile(path, chatString)
}

function markdownChat(messages, ignoreLastInterrupted = true) {
  return messages.reduce((accumulator, current, index, allMessages) => {
    if (current["role"] === "assistant")
      return `${accumulator}${current["content"]}\n\n`

    if (current["role"] === "user") {
      const userMessage = `# ⊙ You\n\n${current["content"]}\n\n# ⊚ Assistant`
      const userTwice = allMessages[index + 1]?.["role"] === "user" // "user" role twice in a row
      const lastMessage = index === allMessages.length - 1 // "user is last message

      return userTwice || (lastMessage && !ignoreLastInterrupted) ?
        `${accumulator}${userMessage}\n\n[Answer Interrupted]\n\n` :
        `${accumulator}${userMessage}\n\n`
    }

    // Ignore any other role
    return accumulator
  }, "")
}

// Read a big-endian uint32 from NSData at the given byte offset
function readUInt32BE(nsData, offset) {
  const sub = nsData.subdataWithRange($.NSMakeRange(offset, 4))
  const desc = sub.description.js
  const match = desc.match(/0x([0-9a-f]+)/i)
  if (!match) return 0
  return parseInt(match[1], 16)
}

// Parse Bedrock event stream binary format and extract text content
function parseEventStream(nsData) {
  const dataLength = nsData.length
  let offset = 0
  let text = ""
  let stopReason = null

  while (offset + 12 <= dataLength) {
    // Each frame: 4-byte total length, 4-byte headers length, 4-byte prelude CRC
    const totalLen = readUInt32BE(nsData, offset)

    // Sanity checks
    if (totalLen < 16 || totalLen > 1048576) break
    if (offset + totalLen > dataLength) break // Incomplete frame, stream still in progress

    const headersLen = readUInt32BE(nsData, offset + 4)

    // Payload starts after prelude (12 bytes) + headers
    const payloadOffset = offset + 12 + headersLen
    // Payload length = totalLen - prelude(12) - headers - message CRC(4)
    const payloadLen = totalLen - 12 - headersLen - 4

    if (payloadLen > 0 && payloadOffset + payloadLen <= dataLength) {
      const payloadData = nsData.subdataWithRange($.NSMakeRange(payloadOffset, payloadLen))
      const payloadStr = $.NSString.alloc.initWithDataEncoding(payloadData, $.NSUTF8StringEncoding)

      if (payloadStr) {
        try {
          const event = JSON.parse(payloadStr.js)

          // Extract text from contentBlockDelta events
          if (event.contentBlockDelta && event.contentBlockDelta.delta && event.contentBlockDelta.delta.text) {
            text += event.contentBlockDelta.delta.text
          }

          // Detect stream completion via messageStop
          if (event.messageStop) {
            stopReason = event.messageStop.stopReason || "end_turn"
          }

          // Detect errors
          if (event.internalServerException || event.modelStreamErrorException ||
              event.validationException || event.throttlingException ||
              event.serviceUnavailableException) {
            const errKey = Object.keys(event).find(k => k.includes("xception") || k.includes("Exception"))
            if (errKey) {
              return { text: "", error: event[errKey].message || JSON.stringify(event[errKey]), stopReason: "error" }
            }
          }
        } catch(e) {
          // Not valid JSON payload, skip this frame
        }
      }
    }

    offset += totalLen
  }

  return { text: text, error: null, stopReason: stopReason }
}

function startStream(region, profile, model, systemPrompt, contextChat, streamFile, pidStreamFile, bodyFile, timeoutSeconds) {
  $.NSFileManager.defaultManager.createFileAtPathContentsAttributes(streamFile, undefined, undefined) // Create empty file

  // Build Bedrock Converse messages format
  const messages = contextChat.map(msg => ({
    role: msg.role,
    content: [{ text: msg.content }]
  }))

  const body = { messages: messages }
  if (systemPrompt) {
    body.system = [{ text: systemPrompt }]
  }

  // Write the request body to a temp file to avoid shell escaping issues
  writeFile(bodyFile, JSON.stringify(body))

  const endpoint = `https://bedrock-runtime.${region}.amazonaws.com/model/${encodeURIComponent(model)}/converse-stream`
  const profileArg = profile ? `--profile ${profile}` : ""

  // Shell script: get credentials, then curl with SigV4 signing, write raw binary to stream file
  const shellScript = [
    '#!/bin/zsh',
    'export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:$PATH"',
    '',
    '# Get AWS credentials',
    `eval "$(aws configure export-credentials --format env ${profileArg} 2>/dev/null)"`,
    '',
    '# Validate credentials were obtained',
    'if [ -z "$AWS_ACCESS_KEY_ID" ] || [ -z "$AWS_SECRET_ACCESS_KEY" ]; then',
    `  echo '{"error":"AWS credentials not found. Run aws configure or aws sso login."}' > "${streamFile}"`,
    '  exit 1',
    'fi',
    '',
    '# Build curl command with SigV4 auth',
    `CURL_ARGS=("${endpoint}")`,
    `CURL_ARGS+=(--speed-limit 0 --speed-time ${timeoutSeconds})`,
    'CURL_ARGS+=(--silent --no-buffer)',
    'CURL_ARGS+=(--header "Content-Type: application/json")',
    `CURL_ARGS+=(--aws-sigv4 "aws:amz:${region}:bedrock")`,
    'CURL_ARGS+=(--user "$AWS_ACCESS_KEY_ID:$AWS_SECRET_ACCESS_KEY")',
    '',
    '# Add session token header if present (SSO / assumed roles)',
    'if [ -n "$AWS_SESSION_TOKEN" ]; then',
    '  CURL_ARGS+=(--header "X-Amz-Security-Token: $AWS_SESSION_TOKEN")',
    'fi',
    '',
    `CURL_ARGS+=(--data @"${bodyFile}")`,
    `CURL_ARGS+=(--output "${streamFile}")`,
    '',
    'curl "${CURL_ARGS[@]}"',
    `rm -f "${bodyFile}"`
  ].join('\n')

  const shellFile = `${envVar("alfred_workflow_cache")}/stream_cmd.sh`
  writeFile(shellFile, shellScript)

  const task = $.NSTask.alloc.init
  const stdout = $.NSPipe.pipe

  task.executableURL = $.NSURL.fileURLWithPath("/bin/zsh")
  task.arguments = [shellFile]
  task.standardOutput = stdout
  task.standardError = $.NSPipe.pipe
  task.launchAndReturnError(false)
  writeFile(pidStreamFile, task.processIdentifier.toString())
}

function readStream(streamFile, chatFile, pidStreamFile, timeoutSeconds) {
  const streamMarker = envVar("stream_marker") === "1"

  // When starting a stream or continuing from a closed window, add a marker
  if (streamMarker) return JSON.stringify({
    rerun: 0.1,
    variables: { streaming_now: true },
    response: "…",
    behaviour: { response: "append" }
  })

  // Read the stream file as raw binary data
  const nsData = $.NSData.dataWithContentsOfFile(streamFile)

  // If file is empty or doesn't exist yet, loop
  if (!nsData || nsData.length === 0) return JSON.stringify({
    rerun: 0.1,
    variables: { streaming_now: true }
  })

  // Check if there's a JSON error message (credentials issue, etc.)
  // This happens when our shell script writes an error JSON directly
  const rawStr = $.NSString.alloc.initWithDataEncoding(nsData, $.NSUTF8StringEncoding)
  if (rawStr) {
    const rawJS = rawStr.js
    if (rawJS.startsWith('{"error"')) {
      try {
        const parsed = JSON.parse(rawJS)
        if (parsed.error) {
          deleteFile(streamFile)
          deleteFile(pidStreamFile)
          return JSON.stringify({
            response: parsed.error,
            behaviour: { response: "replacelast" }
          })
        }
      } catch(e) {}
    }
    // Also check for Bedrock HTTP error responses (plain JSON with "message" field)
    if (rawJS.startsWith('{"message"') || rawJS.startsWith('{"Message"')) {
      try {
        const parsed = JSON.parse(rawJS)
        const errMsg = parsed.message || parsed.Message || "Unknown Bedrock error"
        deleteFile(streamFile)
        deleteFile(pidStreamFile)
        return JSON.stringify({
          response: errMsg,
          behaviour: { response: "replacelast" }
        })
      } catch(e) {}
    }
  }

  // Parse the binary event stream
  const result = parseEventStream(nsData)

  // Handle parse errors
  if (result.error) {
    deleteFile(streamFile)
    deleteFile(pidStreamFile)
    return JSON.stringify({
      response: result.error,
      behaviour: { response: "replacelast" }
    })
  }

  const responseText = result.text

  // If stream is complete (messageStop received)
  if (result.stopReason) {
    appendChat(chatFile, { role: "assistant", content: responseText })
    deleteFile(streamFile)
    deleteFile(pidStreamFile)

    const footerText = (function() {
      switch (result.stopReason) {
        case "max_tokens": return "Maximum number of tokens reached"
        case "content_filtered": return "Content was omitted due to content filters"
      }
    })()

    return JSON.stringify({
      response: responseText,
      footer: footerText,
      behaviour: { response: "replacelast", scroll: "end" }
    })
  }

  // Stream not complete — check if process is still alive
  const pidStr = $.NSString.stringWithContentsOfFileEncodingError(pidStreamFile, $.NSUTF8StringEncoding, undefined)
  let processRunning = false
  if (pidStr) {
    const checkTask = $.NSTask.alloc.init
    checkTask.executableURL = $.NSURL.fileURLWithPath("/bin/kill")
    checkTask.arguments = ["-0", pidStr.js.trim()]
    checkTask.standardOutput = $.NSPipe.pipe
    checkTask.standardError = $.NSPipe.pipe
    try {
      checkTask.launchAndReturnError(false)
      checkTask.waitUntilExit
      processRunning = checkTask.terminationStatus === 0
    } catch(e) {
      processRunning = false
    }
  }

  if (processRunning) {
    // Check for stalled connection
    const stalled = new Date().getTime() - fileModified(streamFile) > timeoutSeconds * 1000

    if (stalled && responseText.length > 0) {
      appendChat(chatFile, { role: "assistant", content: responseText })
      deleteFile(streamFile)
      deleteFile(pidStreamFile)
      return JSON.stringify({
        response: `${responseText} [Connection Stalled]`,
        footer: "You can ask to continue the answer",
        behaviour: { response: "replacelast", scroll: "end" }
      })
    }

    // If no text yet, keep waiting
    if (responseText.length === 0) return JSON.stringify({
      rerun: 0.1,
      variables: { streaming_now: true }
    })

    // Text is coming in, show progress
    return JSON.stringify({
      rerun: 0.1,
      variables: { streaming_now: true },
      response: responseText,
      behaviour: { response: "replacelast", scroll: "end" }
    })
  }

  // Process ended without a messageStop — might be incomplete or error
  if (responseText.length === 0) {
    deleteFile(streamFile)
    deleteFile(pidStreamFile)
    return JSON.stringify({
      response: "Error: No response received. Check your AWS credentials, region, and that the model is enabled in Bedrock.",
      behaviour: { response: "replacelast" }
    })
  }

  // Process ended with some text but no formal stop — save what we have
  appendChat(chatFile, { role: "assistant", content: responseText })
  deleteFile(streamFile)
  deleteFile(pidStreamFile)

  return JSON.stringify({
    response: responseText,
    behaviour: { response: "replacelast", scroll: "end" }
  })
}

// Main
function run(argv) {
  const typedQuery = argv[0]
  const maxContext = parseInt(envVar("max_context"))
  const timeoutSeconds = parseInt(envVar("timeout_seconds"))
  const region = envVar("aws_region") || "us-east-1"
  const profile = envVar("aws_profile") || ""
  const systemPrompt = envVar("system_prompt")
  const model = envVar("chatgpt_model_override") ? envVar("chatgpt_model_override") : envVar("bedrock_model")
  const chatFile = `${envVar("alfred_workflow_data")}/chat.json`
  const pidStreamFile = `${envVar("alfred_workflow_cache")}/pid.txt`
  const streamFile = `${envVar("alfred_workflow_cache")}/stream.bin`
  const bodyFile = `${envVar("alfred_workflow_cache")}/body.json`
  const streamingNow = envVar("streaming_now") === "1"

  // If continually reading from a stream, continue that loop
  if (streamingNow) return readStream(streamFile, chatFile, pidStreamFile, timeoutSeconds)

  // Load previous conversation
  const previousChat = readChat(chatFile)

  // If "streaming_now" is unset but stream file exists, the window was closed mid-stream
  if (fileExists(streamFile)) return JSON.stringify({
    rerun: 0.1,
    variables: { streaming_now: true, stream_marker: true },
    response: markdownChat(previousChat, true),
    behaviour: { scroll: "end" }
  })

  // If argument is empty, return previous conversation
  if (typedQuery.length === 0) return JSON.stringify({
    response: markdownChat(previousChat, false),
    behaviour: { scroll: "end" }
  })

  // Append new question to chat
  const appendQuery = { role: "user", content: typedQuery }
  const ongoingChat = previousChat.concat(appendQuery)
  const contextChat = ongoingChat.slice(-maxContext)

  // Make API request, write chat file, and start loop
  startStream(region, profile, model, systemPrompt, contextChat, streamFile, pidStreamFile, bodyFile, timeoutSeconds)
  appendChat(chatFile, appendQuery)

  return JSON.stringify({
    rerun: 0.1,
    variables: { streaming_now: true, stream_marker: true },
    response: markdownChat(ongoingChat)
  })
}
